        uniform token physics:axis = "Y"
        rel physics:body0 = </CombinedCourse/seesaw_pivot_anchor>
        rel physics:body1 = </CombinedCourse/seesaw_plank>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0.15, 0, -0.0015)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -30
        float physics:upperLimit = 30
        float physxJoint:armature = 0
        float physxJoint:jointFriction = 0
        float physxJoint:maxJointVelocity = 1000
    }

