    def Scope "Lights"
    {
        def DistantLight "SunLight"
        {
            float inputs:angle = 2
            float inputs:intensity = 1500
            float3 xformOp:rotateXYZ = (-50, 0, 30)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def DomeLight "SkyDome"
        {
            float inputs:intensity = 300
        }
    }

