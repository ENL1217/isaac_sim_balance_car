#usda 1.0
(
    defaultPrim = "SlopeWorld"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SlopeWorld"
{
    def Scope "PhysicsMaterials"
    {
        def Material "high_grip" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1
            float physics:restitution = 0
            float physics:staticFriction = 1.2
        }
    }

    def Cube "approach" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </SlopeWorld/PhysicsMaterials/high_grip> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.7, 0.7, 0.72)]
        double size = 1
        float3 xformOp:scale = (2, 1.5, 0.02)
        double3 xformOp:translate = (-1, 0, -0.01)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "ramp" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </SlopeWorld/PhysicsMaterials/high_grip> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.65, 0.55, 0.45)]
        double size = 1
        float3 xformOp:rotateXYZ = (0, -30, 0)
        float3 xformOp:scale = (0.57735026, 1.5, 0.02)
        double3 xformOp:translate = (0.255, 0, 0.13567731325956206)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "top" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </SlopeWorld/PhysicsMaterials/high_grip> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.7, 0.7, 0.72)]
        double size = 1
        float3 xformOp:scale = (2, 1.5, 0.02)
        double3 xformOp:translate = (1.5, 0, 0.27867513459481286)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

