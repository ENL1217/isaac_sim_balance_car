        rel material:binding:physics = </GravelWorld/PhysicsMaterials/gravel> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.55, 0.5, 0.45)]
        double size = 1
        float3 xformOp:scale = (6, 3, 0.02)
        double3 xformOp:translate = (2, 0, -0.01)
